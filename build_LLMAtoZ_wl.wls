#!/usr/bin/env wolframscript
(* Concatenate all per-part .wl source files into one runnable
   LLMAtoZ.wl that the master notebook can Get with a single line.

   Each source file is its own BeginPackage/EndPackage block, so they're
   independent at load time.  We just stitch them together with a
   commented divider per part.

   Output: /Users/thiel/GitHub/LLM-A-to-Z-in-WL/LLMAtoZ.wl                *)

SetDirectory[DirectoryName[$InputFileName]];

(* Order matters only for legibility -- each file is a self-contained
   package.  We follow chapter order from the notebook.                    *)
sources = {
  "Tiers.wl",
  "part-01-tokeniser-and-embeddings/src/Tokeniser.wl",
  "part-02-self-attention/src/Attention.wl",
  "part-03-transformer-block/src/Transformer.wl",
  "part-04-pretraining/src/CharTokeniser.wl",
  "part-04-pretraining/src/Training.wl",
  "part-05-sampling/src/Sampling.wl",
  "part-06-supervised-fine-tuning/src/Classification.wl",
  "part-06-supervised-fine-tuning/src/Lora.wl",
  "part-06-supervised-fine-tuning/src/SFT.wl",
  "part-07-rl-post-training/src/RL.wl",
  "part-08-chat-widget/src/Chat.wl",
  "discussion-model/src/Discussion.wl"};

header = "(* :Title:      LLM A-to-Z in Wolfram Language *)
(* :Created:    Auto-generated by build_LLMAtoZ_wl.wls -- do not edit.   *)
(* :Source:     mthiel74/LLM-A-to-Z-in-WL                                *)

(* This file is the concatenation of the 13 per-part source packages used
   by the master notebook LLM_A_to_Z.nb.  Each package keeps its own
   BeginPackage/EndPackage block, so they coexist cleanly.

   To regenerate after editing the source files, run:
     wolframscript -file build_LLMAtoZ_wl.wls

   Symbols you can use after Get-ing this file live in the contexts:

       LLMAtoZ`Tokeniser`*       (Chapter 1)
       LLMAtoZ`Embedding`*       (Chapter 2)
       LLMAtoZ`Attention`*       (Chapter 3)
       LLMAtoZ`Transformer`*     (Chapter 4)
       LLMAtoZ`CharTokeniser`*   (Chapter 4 alt)
       LLMAtoZ`Training`*        (Chapter 5)
       LLMAtoZ`Sampling`*        (Chapter 6)
       LLMAtoZ`Classification`*  (Chapter 7)
       LLMAtoZ`Lora`*            (Chapter 7)
       LLMAtoZ`SFT`*             (Chapter 7)
       LLMAtoZ`RL`*              (Chapter 8)
       LLMAtoZ`Chat`*            (Chapter 9)
       LLMAtoZ`Discussion`*      (Chapter 10)
*)

";

divider[name_String] := "\n\n(* " <> StringRepeat["=", 70] <> "\n" <>
  "    " <> name <> "\n" <>
  "   " <> StringRepeat["=", 70] <> " *)\n\n";

body = StringJoin @ Map[
  Function[path,
    Module[{content},
      content = Import[FileNameJoin[{Directory[], path}], "Text"];
      divider[path] <> content]],
  sources];

out = FileNameJoin[{Directory[], "LLMAtoZ.wl"}];
Export[out, header <> body, "Text"];
Print["Wrote ", out, " (",
  Round[FileByteCount[out] / 1024, 0.1], " KB, ",
  Length[StringSplit[Import[out, "Text"], "\n"]], " lines)"];
