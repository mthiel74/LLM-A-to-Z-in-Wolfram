Cell[TextData[StyleBox["Figure 3.1.  The QKV picture.  Each input embedding \
is projected by three matrices into a query, a key, and a value.  The dot \
product of every query with every key gives the attention-score matrix.  The \
upper triangle is masked (causal).  Row-wise softmax produces the attention \
weights.  The weighted sum of the values is the output.",
 FontSize->11,
 FontSlant->Italic]], "Text",ExpressionUUID->"09df6661-e9c6-4905-bd28-\
0b3db71f0b51"],

Cell["\<\
Strip the fancy parts away.  Attention is the operation \
\[OpenCurlyDoubleQuote]each output token is a weighted sum of the input \
tokens, where the weights are learned from the input itself.\
\[CloseCurlyDoubleQuote]  Three lines:\
\>", "Text",ExpressionUUID->"4d358a7c-43a2-4d66-b840-16172a59d723"],

Cell[TextData[{
 "\[FilledSmallCircle] Project each input vector three times by ",
 "three learned linear maps: a ",
 StyleBox["query ",
  FontSlant->Italic],
 Cell[BoxData["q"], "Text",
  FontSize->14,ExpressionUUID->"5d7d1c8a-5b95-4574-a14d-ba12fd14d316"],
 ", a ",
 StyleBox["key ",
  FontSlant->Italic],
 Cell[BoxData["k"], "Text",
  FontSize->14,ExpressionUUID->"9a0c26f2-e7f0-4fdc-bff4-da71c14870ea"],
 ", and a ",
 StyleBox["value ",
  FontSlant->Italic],
 Cell[BoxData["v"], "Text",
  FontSize->14,ExpressionUUID->"88e70226-7448-4bfd-bf96-529c14279f89"],
 ".\n",
 "\[FilledSmallCircle] For each position ",
 Cell[BoxData["i"], "Text",
  FontSize->14,ExpressionUUID->"0c6e227e-405c-4c3a-859f-7a3b69563850"],
 ", compute the dot product of ",
 Cell[BoxData[
  SubscriptBox["q", "i"]], "Text",
  FontSize->14,ExpressionUUID->"5965f393-7c43-4214-b34c-fe416874d5b6"],
 " with every ",
 Cell[BoxData[
  SubscriptBox["k", "j"]], "Text",
  FontSize->14,ExpressionUUID->"205c7350-212f-4b35-b0d2-ab4aaeeaf007"],
 " in the sequence.  Softmax these scores along ",
 Cell[BoxData["j"], "Text",
  FontSize->14,ExpressionUUID->"043874c7-016c-4fdd-98e7-93350309377e"],
 " to get attention weights summing to 1.\n",
 "\[FilledSmallCircle] The output at position ",
 Cell[BoxData["i"], "Text",
  FontSize->14,ExpressionUUID->"f4e7bdf7-d158-40d1-8246-ae8140e85b4b"],
 " is the weighted sum of ",
 Cell[BoxData[
  SubscriptBox["v", "j"]], "Text",
  FontSize->14,ExpressionUUID->"87011648-9ced-4070-bccb-f39c08128458"],
 " using those weights."
}], "Text",ExpressionUUID->"b3ceadc8-f3d1-4a1d-a6df-27148d395eac"],

Cell[BoxData[
 RowBox[{"Attention", "(", "Q", ",", " ", "K", ",", " ", "V", ")", 
  RowBox[{" ", 
   RowBox[{"=", " "}]}], "softmax", "(", 
  FractionBox[
   RowBox[{"Q", "\[CenterDot]", 
    SuperscriptBox["K", "\[Transpose]"]}], 
   SqrtBox[
    SubscriptBox["d", "k"]]], ")", "\[CenterDot]", "V"}]], "DisplayFormula",
 TextAlignment->Center,
 FontSize->15,ExpressionUUID->"246ce1c2-69ff-4f18-bf56-e0c530da662a"],

Cell["3.1  Why divide by Sqrt[d_k]?", "Section",ExpressionUUID->"a8a8d1dd-1480-4b53-9d17-8d1b3396cbc7"],

Cell[TextData[{
 "Most expositions assert the ",
 Cell[BoxData[
  FractionBox["1", 
   SqrtBox[
    SubscriptBox["d", "k"]]]], "Text",
  FontSize->14,ExpressionUUID->"6e1deb96-f47c-4c5c-b92c-bec1098cd394"],
 " scaling factor.  We will derive it.  This derivation, along with ",
 "a few similar first-principles arguments later in this notebook, ",
 "is what separates a teaching post from a code dump."
}], "Text",ExpressionUUID->"b0e85e1e-9b2f-460f-9223-a0d71746e707"],

Cell[TextData[{
 "Suppose ",
 Cell[BoxData[
  RowBox[{"q", ",", " ", "k", " ", "\[Element]", " ", 
   SuperscriptBox["\[DoubleStruckCapitalR]", 
    SubscriptBox["d", "k"]]}]], "Text",
  FontSize->14,ExpressionUUID->"a3e9ca55-ec0e-4184-be4d-21d93272637f"],
 " with each component independently drawn from a zero-mean ",
 "unit-variance distribution.  The dot product is a sum of ",
 Cell[BoxData[
  SubscriptBox["d", "k"]], "Text",
  FontSize->14,ExpressionUUID->"f0cdc4f9-dcbb-476c-ad2a-853342fb6759"],
 " random terms ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["q", "i"], 
   SubscriptBox["k", "i"]}]], "Text",
  FontSize->14,ExpressionUUID->"e12bd68a-9221-427f-b3a4-e7375e0c1344"],
 ".  Each term has mean 0 (since ",
 Cell[BoxData[
  RowBox[{"E", "[", 
   SubscriptBox["q", "i"], 
   SubscriptBox["k", "i"], "]"}]], "Text",
  FontSize->14,ExpressionUUID->"dfad528a-7f0a-4010-8d00-fe58ba323359"],
 " = ",
 Cell[BoxData[
  RowBox[{"E", "[", 
   SubscriptBox["q", "i"], "]", "\[CenterDot]", "E", "[", 
   SubscriptBox["k", "i"], "]"}]], "Text",
  FontSize->14,ExpressionUUID->"2fd5b1c0-23a9-4492-9a65-7ba8c9fc0f78"],
 " = 0) and variance ",
 Cell[BoxData[
  RowBox[{"E", "[", 
   SuperscriptBox[
    SubscriptBox["q", "i"], "2"], "]", "\[CenterDot]", "E", "[", 
   SuperscriptBox[
    SubscriptBox["k", "i"], "2"], "]"}]], "Text",
  FontSize->14,ExpressionUUID->"0b8ed229-9ef0-43e9-b1d9-1b25cade7332"],
 " = 1.  By independence across ",
 Cell[BoxData["i"], "Text",
  FontSize->14,ExpressionUUID->"c2044e72-a84c-4136-a0bd-bff413ad0210"],
 ", the variance of the sum is the sum of the variances: ",
 Cell[BoxData[
  RowBox[{"Var", "(", "q", "\[CenterDot]", "k", ")", 
   RowBox[{" ", 
    RowBox[{"=", " "}]}], 
   SubscriptBox["d", "k"]}]], "Text",
  FontSize->14,ExpressionUUID->"5025d754-8450-44e2-a562-0cfaa30bd454"],
 ".  Standard deviation grows as ",
 Cell[BoxData[
  SqrtBox[
   SubscriptBox["d", "k"]]], "Text",
  FontSize->14,ExpressionUUID->"c764c475-6387-4f68-9869-50e323f82262"],
 "."
}], "Text",ExpressionUUID->"191ffd4d-10b8-4911-9215-c2f61963a93c"],

Cell[TextData[{
 "Verify empirically.  Sample 2000 Gaussian (q, k) pairs at three ",
 "values of ",
 Cell[BoxData[
  SubscriptBox["d", "k"]], "Text",
  FontSize->14,ExpressionUUID->"deacd6bf-1ae6-4379-be47-c5e1bd531fda"],
 " and look at the dot-product distribution:"
}], "Text",ExpressionUUID->"ccf88186-8d97-4b32-877b-1682e44e9389"],

Cell["\<\
SeedRandom[1]; nSamples = 2000;
dks = {16, 64, 256};
dots = Association @ Table[
  d -> Table[
    With[{q = RandomReal[NormalDistribution[], d],
          k = RandomReal[NormalDistribution[], d]},
      q . k], {nSamples}], {d, dks}];
StandardDeviation /@ dots\
\>", "Input",ExpressionUUID->"a6b0db07-7c32-48a5-8d6c-30b3f9f2fc45"],

Cell[TextData[{
 "The empirical standard deviations come out to ~4, 8, 16 \[LongDash] exactly \
the predicted ",
 Cell[BoxData[
  SqrtBox[
   SubscriptBox["d", "k"]]], "Text",
  FontSize->14,ExpressionUUID->"8469a42f-c332-489d-9d8f-2e488e313f46"],
 " of 4, 8, 16."
}], "Text",ExpressionUUID->"cbbcbdb5-7377-4edd-9f47-90e58ac21bca"],

