Cell[TextData[StyleBox["Figure 4.2.  Forward-pass activation-norm growth on a \
randomly-initialised stack.  Pre-norm grows linearly with depth; post-norm \
flattens (the LayerNorm at the end of every block pins the magnitude to 1).  \
The reverse pattern in backprop is what makes post-norm hard to train at \
depth without warmup tricks.  GPT-2/3, LLaMA, Mistral, nanochat all use \
pre-norm.",
 FontSize->11,
 FontSlant->Italic]], "Text",ExpressionUUID->"01aa461e-715a-4444-a7e4-\
8827ac3dfcfd"],

Cell["\<\
block = LLMAtoZ`Transformer`transformerBlock[64, 4, 256, 16];
{block[xx] // Dimensions, Information[block, \"ArraysTotalElementCount\"]}\
\>", "Input",ExpressionUUID->"02ad5e8e-c4dc-4e58-bced-0edc32b7c185"],

Cell["4.3  Stacking + the full GPT model", "Section",ExpressionUUID->"d7ed3a9d-aa85-40cd-b8fc-02f985e3bcdf"],

Cell[TextData[{
 "Stack ",
 Cell[BoxData[
  SubscriptBox["n", "layers"]], "Text",
  FontSize->14,ExpressionUUID->"794b652b-283e-4010-b567-0c8b27ec238d"],
 " of these blocks, prepend an embedder, append a final LayerNorm ",
 "and an output projection of shape (",
 Cell[BoxData[
  SubscriptBox["d", "model"]], "Text",
  FontSize->14,ExpressionUUID->"d4602991-5709-4ca8-a857-d9f31c0bd930"],
 ", ",
 Cell[BoxData[
  RowBox[{"|", "V", "|"}]], "Text",
  FontSize->14,ExpressionUUID->"b424a7e9-6b49-4677-9d0d-c4a261144a84"],
 "), and you have a complete GPT-style language model."
}], "Text",ExpressionUUID->"f9322112-0187-478a-b425-1e959773d85c"],

Cell["\<\
model = LLMAtoZ`Transformer`gptModel[256, 8, 6, 1024, 1064, 256];
demoIds = RandomInteger[{1, 1064}, 256];
Dimensions[model[demoIds]]\
\>", "Input",ExpressionUUID->"1b935c86-6c74-4f23-9508-294dcd0099c1"],

Cell["\<\
(seqLen, |V|) out, as advertised.  Every row of the output is the pre-softmax \
logit vector at one position.  During training we shift by one and ask the \
model to predict the next token.  During inference we apply softmax to the \
last row and sample.\
\>", "Text",ExpressionUUID->"1acf1e71-1424-4999-959f-dc2de51cec95"],

Cell["4.4  Counting parameters", "Section",ExpressionUUID->"59ac8c5b-42eb-445d-8510-4e81e502fc11"],

Cell[TextData[{
 "A pre-norm transformer block of size (",
 Cell[BoxData[
  SubscriptBox["d", "model"]], "Text",
  FontSize->14,ExpressionUUID->"16a34cb6-9346-42fa-b13a-9797cf5c0838"],
 ", ",
 Cell[BoxData[
  SubscriptBox["d", "ff"]], "Text",
  FontSize->14,ExpressionUUID->"66cba663-be8d-4217-96d4-1ca65e0a8682"],
 ", ",
 Cell[BoxData[
  SubscriptBox["n", "heads"]], "Text",
  FontSize->14,ExpressionUUID->"d4a4e647-64fd-4471-a8e6-6f12917acf67"],
 ") has, in closed form:"
}], "Text",ExpressionUUID->"f380f04a-a65f-49bd-ad82-c4553b838348"],

Cell[TextData[{
 "\[FilledSmallCircle] Q, K, V projections summed over heads: ",
 Cell[BoxData[
  RowBox[{"3", 
   SuperscriptBox[
    SubscriptBox["d", "model"], "2"]}]], "Text",
  FontSize->14,ExpressionUUID->"170d972d-605e-4876-9ac7-475187d2fd8d"],
 ".\n",
 "\[FilledSmallCircle] Output projection: ",
 Cell[BoxData[
  SuperscriptBox[
   SubscriptBox["d", "model"], "2"]], "Text",
  FontSize->14,ExpressionUUID->"d3939d2d-1207-4d74-a6a9-2d4f265d2176"],
 ".\n",
 "\[FilledSmallCircle] Two LayerNorms (scale + bias each): ",
 Cell[BoxData[
  RowBox[{"4", 
   SubscriptBox["d", "model"]}]], "Text",
  FontSize->14,ExpressionUUID->"f5ad412a-b5a8-4739-9d0a-2dc3d451c801"],
 ".\n",
 "\[FilledSmallCircle] FFN linears (with biases): ",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox["d", "model"], 
   SubscriptBox["d", "ff"], 
   RowBox[{" ", 
    RowBox[{"+", " "}]}], 
   SubscriptBox["d", "ff"], 
   RowBox[{" ", 
    RowBox[{"+", " "}]}], 
   SubscriptBox["d", "model"]}]], "Text",
  FontSize->14,ExpressionUUID->"589c7323-01b9-467b-a1f5-018e7b52fedf"],
 "."
}], "Text",ExpressionUUID->"02bec0a8-c81d-42cf-b211-fbfb65ee60c1"],

Cell[BoxData[
 RowBox[{
  SubscriptBox["params", "block"], 
  RowBox[{" ", 
   RowBox[{"=", " "}]}], "4", 
  SuperscriptBox[
   SubscriptBox["d", "model"], "2"], 
  RowBox[{" ", 
   RowBox[{"+", " "}]}], "2", 
  SubscriptBox["d", "model"], 
  SubscriptBox["d", "ff"], 
  RowBox[{" ", 
   RowBox[{"+", " "}]}], 
  SubscriptBox["d", "ff"], 
  RowBox[{" ", 
   RowBox[{"+", " "}]}], "5", 
  SubscriptBox["d", "model"]}]], "DisplayFormula",
 TextAlignment->Center,
 FontSize->15,ExpressionUUID->"310b33e2-a52f-4fbb-86ab-db543bb63123"],

Cell[TextData[{
 "On top of the blocks: embeddings (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["d", "model"], "(", 
   RowBox[{"|", "V", "|"}], 
   RowBox[{" ", 
    RowBox[{"+", " "}]}], 
   SubscriptBox["n", "max"], ")"}]], "Text",
  FontSize->14,ExpressionUUID->"e80cd3a6-314a-4936-af98-64ec46565a61"],
 "), a final LayerNorm (",
 Cell[BoxData[
  RowBox[{"2", 
   SubscriptBox["d", "model"]}]], "Text",
  FontSize->14,ExpressionUUID->"22f0a8b4-42ee-48c5-8fdf-c30ffc6a5a5d"],
 "), and an output projection (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["d", "model"], 
   RowBox[{"|", "V", "|"}]}]], "Text",
  FontSize->14,ExpressionUUID->"82445fe8-f510-429f-8f11-d0f18b3d4fc8"],
 "; can be tied to the input embedding to save these parameters).  ",
 StyleBox["parameterCount[spec]",
  FontFamily->"Courier"],
 " computes the closed form; ",
 StyleBox["parameterCountFull[spec]",
  FontFamily->"Courier"],
 " adds the frozen causal-mask arrays we bake into each attention ",
 "head (one ",
 Cell[BoxData[
  SubscriptBox["n", "heads"]], "Text",
  FontSize->14,ExpressionUUID->"a6e753b8-e529-4c6d-956c-874f15b190a6"],
 " \[Times] (maxSeqLen)\[Times](maxSeqLen) tensor per layer)."
}], "Text",ExpressionUUID->"75669e6d-2b05-49eb-bf8d-49f345a0886f"],

