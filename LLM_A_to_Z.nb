Cell[TextData[StyleBox["Figure 3.6.  Three hand-picked heads of layer 5.  \
Left: previous-token tracker.  Middle: self-attention diagonal.  Right: \
approximately uniform.  None of these specialisations is enforced \
architecturally; they are what twelve heads turn into when trained against \
billions of tokens of text.",
 FontSize->11,
 FontSlant->Italic]], "Text",ExpressionUUID->"921ac5ca-d481-49bd-b9eb-\
2d7b3407adb3"],

Cell["3.5.1  Interactive: layer/head scrubber", "Subsection",ExpressionUUID->"89ae9427-3895-4d22-ab11-efe756391af7"],

Cell[TextData[{
 "Pre-extracted attention tensors for every layer of GPT-2 small on ",
 "the same prompt are cached in ",
 StyleBox["part-02-self-attention/data/gpt2_attention_all_layers.wxf",
  FontFamily->"Courier"],
 "."
}], "Text",ExpressionUUID->"140b31be-dae9-4a4f-844f-2308bd36f1da"],

Cell["\<\
attCache = Import[\"part-02-self-attention/data/gpt2_attention_all_layers.wxf\
\"];
Manipulate[
  With[{w = attCache[\"weights\"][layer][[head]],
        n = Length[attCache[\"ids\"]]},
    MatrixPlot[w, ColorFunction -> \"ThermometerColors\",
      ColorFunctionScaling -> True,
      FrameTicks -> {{Range[n], None}, {Range[n], None}},
      PlotLabel -> Row[{\"GPT-2 small  \[Bullet]  layer \", layer,
        \"  \[Bullet]  head \", head}],
      PlotLegends -> Automatic, ImageSize -> 640]],
  {{layer, 5, \"layer\"}, 1, 12, 1, Appearance -> \"Labeled\"},
  {{head, 1, \"head\"}, 1, 12, 1, Appearance -> \"Labeled\"},
  ControlPlacement -> Top]\
\>", "Input",ExpressionUUID->"7f01e4b0-4324-4542-8240-21b80683e464"],

Cell["4.  The transformer block + parameter accounting", "Chapter",ExpressionUUID->"b99838ee-fb55-41b5-9f43-800f80710cef"],

