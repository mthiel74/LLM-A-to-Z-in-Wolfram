}, Open  ]],

Cell["\<\
Encode + truncate / pad to a fixed context length of 128 tokens, then split \
each sequence into shifted input / target pairs.\
\>", "Text",ExpressionUUID->"c518810f-6e20-4d7b-af01-63ae249f2487"],

Cell[CellGroupData[{

Cell["\<\
dataset = LLMAtoZ`Discussion`buildSftDataset[
  LLMAtoZ`Discussion`formatPair /@ examples,
  encoder, 128];
Print[\"examples: \", Length[dataset]];
Print[\"first example shape: input=\", Length[dataset[[1]][\"Input\"]],
      \"  output=\", Length[dataset[[1]][\"Output\"]]]\
\>", "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"677f0746-2f03-40ae-9107-a33a8caeead6"],

