Cell[CellGroupData[{

Cell["5.  Training (the actual SFT)", "Chapter",ExpressionUUID->"e91f2191-0805-4581-9000-9a1cd69fde6a"],

Cell[TextData[{
 "On a Mac mini CPU at batch_size 4, GPT-2 small SFT runs at about ",
 StyleBox["0.42 s/example",
  FontWeight->Bold],
 " in steady state.  10,000 examples \[Times] 3 epochs = 30,000 forward+",
 "backward passes; about 3.5 hours wall.  ",
 StyleBox["trainOvernight",
  FontFamily->"Courier"],
 " checkpoints to disk every 30 minutes so an early ",
 StyleBox["Ctrl-C",
  FontFamily->"Courier"],
 " still leaves you with a ",
 "usable model."
}], "Text",ExpressionUUID->"9bfc1b19-b967-40f2-bd5d-0d49b29cccdd"],

Cell["\<\
Heavy run -- skip in interactive notebook use.  Kick it off from a shell \
instead and read the progress log:\
\>", "Text",ExpressionUUID->"233018a3-01a7-43e7-ab08-34048fdfe9f6"],

Cell["\<\
wolframscript -file discussion-model/src/run_discussion_sft.wls 10000 3
tail -f discussion-model/data/discussion_progress.txt\
\>", "Program",ExpressionUUID->"44e166ef-6222-40a3-8516-f07e5600a323"],

Cell["\<\
The cells below load a previously-trained checkpoint and exercise it.  Until \
that file exists, the chat widget at the end will show a warning placeholder.\
\
\>", "Text",ExpressionUUID->"18dc4aa0-2c38-4a9c-bd3b-ac659093fccf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.  Load the trained model", "Chapter",ExpressionUUID->"9dcf73a3-6641-44fd-986c-482fb9fe7f68"],

Cell[TextData[{
 "The notebook expects to be opened from ",
 StyleBox["discussion-model/",
  FontFamily->"Courier"],
 ", so paths below are anchored at ",
 StyleBox["NotebookDirectory[]",
  FontFamily->"Courier"],
 ".  Pick the best available trained checkpoint: the cloud-trained ",
 "GPT-2 medium (1.35 GB) if you have it, else the local GPT-2 small ",
 "SFT (498 MB), else fall back to the untrained trunk so the rest ",
 "of the chapter still runs."
}], "Text",ExpressionUUID->"e97f22f6-f324-4345-863d-807c00e0ac33"],

Cell[CellGroupData[{

Cell["\<\
SetDirectory[NotebookDirectory[]];
candidates = {
  \"data/discussion_medium_20k.wlnet\",
  \"data/discussion_sft.wlnet\",
  \"data/discussion_sft_ckpt.wlnet\"};
sftPath = SelectFirst[candidates, FileExistsQ, None];
sftNet = If[sftPath === None,
  Print[Style[\"No trained checkpoint found in data/.  Using untrained \" <>
              \"trunk; chat widget will produce nonsense.\", Red]];
  trunk,
  Print[\"Loading \", sftPath, \" ...\"];
  Import[sftPath]];
Information[sftNet, \"ArraysTotalElementCount\"]\
\>", "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"5b3a3d28-8923-4926-b66c-e290fc5fe277"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Loading \"\>", 
   "\[InvisibleSpace]", "\<\"data/discussion_medium_20k.wlnet\"\>", 
   "\[InvisibleSpace]", "\<\" ...\"\>"}],
  SequenceForm["Loading ", "data/discussion_medium_20k.wlnet", " ..."],
  Editable->False]], "Print",
 CellChangeTimes->{3.9883668528251743`*^9},
 CellLabel->
  "During evaluation of \
In[102]:=",ExpressionUUID->"55af3944-f039-447d-a60a-9bc5559ca731"],

Cell[BoxData["354823168"], "Output",
 CellChangeTimes->{3.988366853712248*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"afbd5494-f67f-40c4-a9f9-085b41c0df38"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.  Generation", "Chapter",ExpressionUUID->"154b982d-2906-45ba-a93b-6f61a1fb5992"],

Cell[TextData[{
 "Sampling is the same recipe as Chapter 6 of the master notebook: ",
 "temperature + top-k.  ",
 StyleBox["generate",
  FontFamily->"Courier"],
 " also stops cleanly when the model produces ",
 StyleBox["\\n",
  FontFamily->"Courier"],
 StyleBox["User: ",
  FontFamily->"Courier"],
 " -- it would otherwise babble onwards into a new turn."
}], "Text",ExpressionUUID->"740fd2c1-2f04-4ff9-9ab2-61c340fcfe6f"],

Cell[CellGroupData[{

Cell["\<\
decoderFn = LLMAtoZ`Discussion`makeIdDecoder[gpt];
SeedRandom[2026];
LLMAtoZ`Discussion`generate[sftNet, encoder, decoderFn,
  \"User: What is a sonnet?\\nAssistant:\",
  <|\"MaxNew\" -> 80, \"Temperature\" -> 0.7, \"TopK\" -> 40|>]\
\>", "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"0485e524-1b45-4e35-9b47-acad857ecca9"],

Cell[BoxData["\<\" A sonnet is a piece of music or poetry, written by a \
person or group of people, typically in praise and praise of nature, and sung \
to a particular tune. It is a form of communication that is meant to convey a \
message of gratitude or appreciation, often in praise of the beauty or the \
harmony of nature.\\n t t t\"\>"], "Output",
 CellChangeTimes->{3.988366894421597*^9},
 CellLabel->
  "Out[109]=",ExpressionUUID->"d84a2129-023a-4545-bd31-444fc48449c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
LLMAtoZ`Discussion`generate[sftNet, encoder, decoderFn,
  \"User: How are you today?\\nAssistant:\",
  <|\"MaxNew\" -> 60, \"Temperature\" -> 0.7|>]\
\>", "Input",
 CellLabel->
  "In[110]:=",ExpressionUUID->"51220bfd-3077-4e8a-bc46-1b93218b13d0"],

Cell[BoxData["\<\" As an AI, I am currently performing my tasks and \
activities as requested. I am programmed to respond to my users' queries and \
provide accurate and consistent information.\\n t t t\"\>"], "Output",
 CellChangeTimes->{3.988366909848542*^9},
 CellLabel->
  "Out[110]=",ExpressionUUID->"9b6e74be-d18c-4ab7-910a-e448a31fea65"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
LLMAtoZ`Discussion`generate[sftNet, encoder, decoderFn,
  \"User: Give three tips for staying healthy.\\nAssistant:\",
  <|\"MaxNew\" -> 120, \"Temperature\" -> 0.7|>]\
\>", "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"1727ba69-9d4c-4f15-8a39-bb91d26f5391"],

Cell[BoxData["\<\" 1. Eat a variety of nutrient-dense foods: One of the best \
ways to stay healthy is to eat a variety of nutrient-dense foods. This \
includes fruits, vegetables, whole grains, lean proteins, whole grain breads, \
and whole grain pasta.\\n\\n2. Get enough sleep: Getting enough quality sleep \
is essential for good health. Aim for at least 7-8 hours of quality sleep \
every night.\\n\\n3. Get enough physical activity: Physical activity helps to \
burn calories, build muscle, improve endurance, and maintain good mental \
health. Aim for at least 20 minutes of moderate\"\>"], "Output",
 CellChangeTimes->{3.988366979787492*^9},
 CellLabel->
  "Out[111]=",ExpressionUUID->"dc40d151-c1f1-4f9e-9831-85096e3ee9af"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.  Interactive chat widget", "Chapter",ExpressionUUID->"c827809b-f59b-4e66-af13-39cd70e469f9"],

Cell[TextData[{
 "Multi-turn chat via ",
 StyleBox["DynamicModule",
  FontFamily->"Courier"],
 ".  Each Send concatenates the running transcript with the new user ",
 "message in the User/Assistant template and feeds it to ",
 StyleBox["chatTurn",
  FontFamily->"Courier"],
 "."
}], "Text",ExpressionUUID->"fbc5a47a-2d8f-4cb2-80ed-93ff5ee76401"],

Cell[TextData[{
 "If after clicking ",
 StyleBox["Send",
  FontWeight->Bold],
 " you see ",
 StyleBox["Thinking\[Ellipsis]",
  FontSlant->Italic],
 " for 10\[Dash]60 seconds: that's expected.  GPT-2 small inference ",
 "in Wolfram Language on a Mac mini CPU runs around 5 tokens/sec, ",
 "so an 80-token reply takes 15\[Dash]20 s.  GPT-2 medium is even ",
 "slower (\[TildeTilde]60 s per reply).  When the model finishes, ",
 "the new turn appears in the transcript pane above the input."
}], "Text",ExpressionUUID->"6638b2fd-7d47-4641-9997-89b2d76f1feb"],

Cell[CellGroupData[{

Cell["\<\
DynamicModule[{history = {}, userInput = \"\", thinking = False},
  Framed[
    Column[{
      Style[\"Discussion model \[Bullet] \" <> sftPath, Bold, 14,
            FontFamily -> \"Helvetica\"],
      Spacer[8],
      (* Transcript pane.  Wrap in a Framed Pane so the conversation
         scrolls.  We rebuild from `history` on every change. *)
      Framed[
        Dynamic[
          If[Length[history] == 0 && !thinking,
            Style[\"(no messages yet \[Dash] type below and click Send)\",
                  FontSlant -> Italic, FontColor -> Gray,
                  FontFamily -> \"Helvetica\"],
            Column[Join[
              Map[Function[turn,
                Column[{
                  Row[{Style[\"User: \", Bold, FontFamily -> \"Helvetica\"],
                       Style[turn[\"user\"], FontFamily -> \"Helvetica\"]}],
                  Row[{Style[\"AI:   \", Bold,
                             FontFamily -> \"Helvetica\",
                             FontColor -> RGBColor[0.2, 0.4, 0.7]],
                       Style[turn[\"assistant\"],
                             FontFamily -> \"Helvetica\"]}],
                  Spacer[6]}]], history],
              If[thinking,
                {Style[\"AI:   thinking\[Ellipsis]\", Bold,
                       FontFamily -> \"Helvetica\",
                       FontColor -> RGBColor[0.5, 0.5, 0.5],
                       FontSlant -> Italic]}, {}]]]]],
        Background -> RGBColor[0.97, 0.97, 1.0],
        FrameStyle -> RGBColor[0.85, 0.85, 0.9],
        RoundingRadius -> 6, ImageSize -> {640, Automatic},
        FrameMargins -> 10],
      Spacer[6],
      InputField[Dynamic[userInput], String,
        FieldSize -> {60, 2}, FieldHint -> \"Type your message...\"],
      Spacer[4],
      Row[{
        Button[\"Send\",
          If[StringQ[userInput] && StringLength[StringTrim[userInput]] > 0,
            Module[{msg = StringTrim[userInput], reply},
              userInput = \"\";
              thinking = True;
              reply = LLMAtoZ`Discussion`chatTurn[
                sftNet, history, msg, encoder, decoderFn,
                <|\"MaxNew\" -> 80, \"Temperature\" -> 0.7, \"TopK\" -> \
40|>];
              AppendTo[history, <|\"user\" -> msg,
                                  \"assistant\" -> StringTrim[reply]|>];
              thinking = False]],
          Method -> \"Queued\",
          Background -> RGBColor[0.2, 0.55, 0.85],
          BaseStyle -> {FontFamily -> \"Helvetica\", Bold, White}],
        Spacer[6],
        Button[\"Reset\", history = {}; userInput = \"\";
                          thinking = False,
          Background -> RGBColor[0.9, 0.9, 0.9],
          BaseStyle -> {FontFamily -> \"Helvetica\"}]
      }]
    }],
    Background -> White,
    FrameStyle -> RGBColor[0.6, 0.6, 0.65],
    RoundingRadius -> 8, FrameMargins -> 14]
]\
\>", "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"aa28c299-995b-484f-ac1e-9d0866f3f4a9"],

Cell[BoxData[
 DynamicModuleBox[{$CellContext`history$$ = {<|
   "user" -> "What is an internal combustion engine?", "assistant" -> 
    "An internal combustion engine is an engine that produces power by using \
both internal combustion (or combustion) and mechanical power. It is a type \
of engine that uses the kinetic energy produced by the motion of an object \
through a process of combustion. This kinetic energy is used to move the \
piston or cylinder, and the kinetic energy of the fuel or oxidizer that is in \
use is used to propel an object."|>}, $CellContext`userInput$$ = 
  "", $CellContext`thinking$$ = False}, 
  FrameBox[
   TagBox[GridBox[{
      {
       StyleBox["\<\"Discussion model \[Bullet] \
data/discussion_medium_20k.wlnet\"\>",
        StripOnInput->False,
        FontFamily->"Helvetica",
        FontSize->14,
        FontWeight->Bold]},
      {
       TemplateBox[{8},
        "Spacer1"]},
      {
       FrameBox[
        DynamicBox[ToBoxes[
          If[
           And[Length[$CellContext`history$$] == 0, 
            Not[$CellContext`thinking$$]], 
           Style[
           "(no messages yet \[Dash] type below and click Send)", FontSlant -> 
            Italic, FontColor -> Gray, FontFamily -> "Helvetica"], 
           Column[
            Join[
             Map[
              Function[$CellContext`turn, 
               Column[{
                 Row[{
                   Style["User: ", Bold, FontFamily -> "Helvetica"], 
                   Style[
                    $CellContext`turn["user"], FontFamily -> "Helvetica"]}], 
                 Row[{
                   Style[
                   "AI:   ", Bold, FontFamily -> "Helvetica", FontColor -> 
                    RGBColor[0.2, 0.4, 0.7]], 
                   Style[
                    $CellContext`turn["assistant"], FontFamily -> 
                    "Helvetica"]}], 
                 Spacer[6]}]], $CellContext`history$$], 
             If[$CellContext`thinking$$, {
               Style[
               "AI:   thinking\[Ellipsis]", Bold, FontFamily -> "Helvetica", 
                FontColor -> RGBColor[0.5, 0.5, 0.5], FontSlant -> 
                Italic]}, {}]]]], StandardForm],
         ImageSizeCache->{618., {73.71717863918842, 79.44911223293842}}],
        Background->RGBColor[0.97, 0.97, 1.],
        FrameMargins->10,
        FrameStyle->RGBColor[0.85, 0.85, 0.9],
        ImageSize->{640, Automatic},
        RoundingRadius->6,
        StripOnInput->False]},
      {
       TemplateBox[{6},
        "Spacer1"]},
      {
       InputFieldBox[Dynamic[$CellContext`userInput$$], String,
        FieldHint->"Type your message...",
        FieldSize->{60, 2}]},
      {
       TemplateBox[{4},
        "Spacer1"]},
      {
       TemplateBox[{
         ButtonBox["\"Send\"", ButtonFunction :> If[
            And[
             StringQ[$CellContext`userInput$$], StringLength[
               StringTrim[$CellContext`userInput$$]] > 0], 
            
            Module[{$CellContext`msg$ = 
              StringTrim[$CellContext`userInput$$], $CellContext`reply$}, \
$CellContext`userInput$$ = ""; $CellContext`thinking$$ = 
              True; $CellContext`reply$ = 
              LLMAtoZ`Discussion`chatTurn[$CellContext`sftNet, \
$CellContext`history$$, $CellContext`msg$, $CellContext`encoder, \
$CellContext`decoderFn, <|
                "MaxNew" -> 80, "Temperature" -> 0.7, "TopK" -> 40|>]; 
             AppendTo[$CellContext`history$$, <|
               "user" -> $CellContext`msg$, "assistant" -> 
                StringTrim[$CellContext`reply$]|>]; $CellContext`thinking$$ = 
              False]], Method -> "Queued", Background -> 
          RGBColor[0.2, 0.55, 0.85], 
          BaseStyle -> {FontFamily -> "Helvetica", Bold, 
            GrayLevel[1]}, Appearance -> Automatic, Evaluator -> Automatic], 
         TemplateBox[{6}, "Spacer1"], 
         ButtonBox[
         "\"Reset\"", 
          ButtonFunction :> ($CellContext`history$$ = {}; \
$CellContext`userInput$$ = ""; $CellContext`thinking$$ = False), Background -> 
          RGBColor[0.9, 0.9, 0.9], BaseStyle -> {FontFamily -> "Helvetica"}, 
          Appearance -> Automatic, Evaluator -> Automatic, Method -> 
          "Preemptive"]},
        "RowDefault"]}
     },
     DefaultBaseStyle->"Column",
     GridBoxAlignment->{"Columns" -> {{Left}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
    "Column"],
   Background->GrayLevel[1],
   FrameMargins->14,
