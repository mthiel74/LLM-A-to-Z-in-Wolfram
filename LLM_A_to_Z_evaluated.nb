Cell["3.  Attention: the operation the architecture is named for", "Chapter",ExpressionUUID->"3902f955-0437-4bae-a6ff-f7268572594a"],

Cell[BoxData[
 GraphicsBox[
  TagBox[RasterBox[CompressedData["1:"], {{0, 667.}, {1000., 0}}, {0, 255},
    ColorFunction->RGBColor,
    ImageResolution->{72, 72}],
   BoxForm`ImageTag[
   "Byte", ColorSpace -> "RGB", Interleaving -> True, 
    MetaInformation -> <|
