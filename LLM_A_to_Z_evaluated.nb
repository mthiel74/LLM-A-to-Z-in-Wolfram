Cell[TextData[{
 "Three nodes: token embedding, position embedding, and an ",
 "elementwise add.  Inputs are a token-ID sequence and a position-ID ",
 "sequence; output is a ",
 Cell[BoxData[
  RowBox[{"(", "seqLen", ",", " ", 
   SubscriptBox["d", "model"], ")"}]], "Text",
  FontSize->14,ExpressionUUID->"3b0eda44-8b4d-407a-919e-d9acd2e06501"],
 " tensor, the standard input shape of the transformer block we ",
 "build in Chapter 4."
}], "Text",ExpressionUUID->"985cba07-f5c8-4af8-94fd-27efe0d89db7"],

Cell["\<\
ids = LLMAtoZ`Tokeniser`encodeWithIds[
  \"To be or not to be, that is the question.\",
  mergeRules, tokId];
LLMAtoZ`Tokeniser`embedTokens[embedder, ids] // Dimensions\
\>", "Input",ExpressionUUID->"9095cb62-c97a-4e01-81e8-e2c43d80d60c"],

Cell["{12, 64}", "Output",
 FontFamily->"Courier",
 FontSize->12,
 CellLabel->"Out= ",ExpressionUUID->"47e0e2bc-1532-4130-8ba6-978395d46361"],

Cell["\<\
Twelve tokens in, a 12\[Times]64 tensor out.  That tensor is exactly what the \
first transformer block will consume.\
\>", "Text",ExpressionUUID->"c7886317-a56f-4ad0-8413-55ff72298fb2"],

Cell["2.3  Geometry before training", "Section",ExpressionUUID->"1aeda487-5938-4201-bcb0-4afbb4e81d1c"],

Cell[TextData[{
 "The token-embedding row for ",
 StyleBox["\"the\"",
  FontFamily->"Courier"],
 " right now is just a vector of 64 Gaussian noise samples.  ",
 "Whatever similarity structure the trained model will eventually ",
 "have \[LongDash] words near their inflections, punctuation off in ",
 "its own corner \[LongDash] is not in there yet.  It is useful to ",
 "see the \[OpenCurlyDoubleQuote]before\[CloseCurlyDoubleQuote] ",
 "picture so we have a baseline to revisit later."
}], "Text",ExpressionUUID->"6de2bc18-5335-4124-b2cc-1bfb37a1e544"],

