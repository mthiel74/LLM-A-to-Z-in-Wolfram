Cell["4.  The transformer block + parameter accounting", "Chapter",ExpressionUUID->"d9bff132-8f74-44a5-8d07-9f9384206b82"],

Cell[BoxData[
 GraphicsBox[
  TagBox[RasterBox[CompressedData["1:"], {{0, 1500.}, {1000., 0}}, {0, 255},
    ColorFunction->RGBColor,
    ImageResolution->{72, 72}],
