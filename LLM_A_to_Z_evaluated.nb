Cell[TextData[StyleBox["Figure 5.4.  Conceptually: the train/eval gap.  Train \
loss continues to descend; eval loss plateaus.  The growing gap is \
memorisation, not learning.",
 FontSize->11,
 FontSlant->Italic]], "Text",ExpressionUUID->"e8994bd6-1962-43a9-9d0a-\
e0020fc36a14"],

Cell["\<\
After 23 rounds, train loss was 0.74.  Held-out eval loss was 2.59, for a \
train/eval ratio of 3.49 \[LongDash] a clear overfit signature.  With 1.8M \
parameters memorising a 1.08M-character corpus, the model has more capacity \
than the data needs and gradient descent preferentially memorises.  Further \
training would push train loss down without making the model actually \
generalise better.  The checkpoint we ship is the one at this point.\
\>", "Text",ExpressionUUID->"8b6f8f0b-a73c-4046-b288-d232f89b4f3d"],

Cell["6.  Sampling: turning logits into text", "Chapter",ExpressionUUID->"e2c50079-338f-4d57-bfcf-157f21a382ff"],

Cell[TextData[{
 "The trained model is a function from a length-",
 Cell[BoxData["L"], "Text",
  FontSize->14,ExpressionUUID->"4d933cd6-80c2-4d13-9e51-03b7011bcd51"],
 " context window to a length-",
 Cell[BoxData[
  RowBox[{"|", "V", "|"}]], "Text",
  FontSize->14,ExpressionUUID->"9c249b2e-f2b0-4c10-876d-ce8d97549a37"],
 " logit vector at every position.  Sampling is the policy that ",
 "turns those logits into a chosen next token.  Five strategies plus ",
 "speculative decoding, all from scratch."
}], "Text",ExpressionUUID->"7b663cdd-9e74-4b85-a009-d931dd5aa306"],

Cell["6.1  Temperature", "Section",ExpressionUUID->"9cde2f36-1760-401f-8c38-794b96c4d162"],

Cell[TextData[{
 "The simplest dial: softmax-with-temperature.  ",
 Cell[BoxData[
  RowBox[{
  "p", " ", "\[Proportional]", " ", "exp", "(", "logits", "/", "T", ")"}]], 
  "Text",
  FontSize->14,ExpressionUUID->"c657d41b-c82d-4426-b21d-61ce7be3ad80"],
 ".  ",
 Cell[BoxData[
  RowBox[{"T", " ", "\[Rule]", " ", "0"}]], "Text",
  FontSize->14,ExpressionUUID->"03497fec-aa1e-40d1-a89e-1a47e8a83981"],
 " is argmax (greedy); ",
 Cell[BoxData[
  RowBox[{"T", " ", "=", " ", "1"}]], "Text",
  FontSize->14,ExpressionUUID->"a301f906-3997-46ce-b52b-e6afc7e771a4"],
 " is the model's calibrated distribution; ",
 Cell[BoxData[
  RowBox[{"T", " ", ">", " ", "1"}]], "Text",
  FontSize->14,ExpressionUUID->"ea58a30f-b232-4eea-9dfc-ad714d72b64a"],
 " softens; ",
 Cell[BoxData[
  RowBox[{"T", " ", "\[Rule]", " ", "\[Infinity]"}]], "Text",
  FontSize->14,ExpressionUUID->"0c07c641-b4f2-4d9a-b194-be09e2ec651a"],
 " is uniform.  The same 20-element ",
 "logit vector, five different temperatures \[LongDash] watch how ",
 "the probability mass spreads out:"
}], "Text",ExpressionUUID->"537d54ad-5529-4b6f-8a59-d7f9a36ed620"],

Cell["\<\
SeedRandom[3]; demoLogits = Sort[
  RandomReal[NormalDistribution[0, 1.5], 20], Greater];
softmaxT[logits_, T_] :=
  LLMAtoZ`Sampling`softmaxTemperature[logits, T];
entropyOf[p_] := -Total[p * Log[p + 1.*^-12]];

GraphicsGrid[
  Partition[
    Table[
      BarChart[softmaxT[demoLogits, T],
        Frame -> True,
        FrameLabel -> {\"token id (sorted by logit)\", \"p\"},
        PlotLabel -> Row[{\"T = \", NumberForm[T, 3],
          \"   entropy = \",
          NumberForm[entropyOf[softmaxT[demoLogits, T]], 3]}],
        PlotRange -> {Automatic, {0, 1}},
        ChartStyle -> ColorData[97][1],
        ImageSize -> 420],
      {T, {0.2, 0.5, 1.0, 2.0, 3.0}}],
    2, 2, {1, 1}, {}],
  ImageSize -> 900, Spacings -> 8]\
\>", "Input",ExpressionUUID->"c14fef50-09b7-45ac-bf47-f4e0a1cb8f2f"],

Cell[BoxData[
 GraphicsBox[
  TagBox[RasterBox[CompressedData["1:"], {{0, 720.72}, {720., 0}}, {0, 255},
    ColorFunction->RGBColor,
    ImageResolution->{100, 100}],
   BoxForm`ImageTag[
   "Byte", ColorSpace -> "RGB", Interleaving -> True, 
    MetaInformation -> <|
     "Exif" -> <|
       "ImageWidth" -> 1000, "ImageLength" -> 1001, "XResolution" -> 100, 
        "YResolution" -> 100, "ResolutionUnit" -> "Inch", "Software" -> 
        "Created with the Wolfram Language : www.wolfram.com", "DateTime" -> 
        DateObject[{2026, 5, 21, 15, 44, 56.}, "Instant", "Gregorian", 1.], 
        "TimeZoneOffset" -> 1|>|>],
   Selectable->False],
  DefaultBaseStyle->"ImageGraphics",
  ImageSizeRaw->{720., 720.72},
  PlotRange->{{0, 720.}, {0, 720.72}}]], "Output",
 CellMargins->{{Inherited, Inherited}, {5, 10}},
 TextAlignment->Center,
 CellLabel->"",ExpressionUUID->"33f70e39-c530-4680-9bc7-ce5a8f2511cb"],

Cell[TextData[{
 StyleBox["Figure 6.1.",
  FontWeight->Bold],
 "  Same logit vector at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"T", " ", "=", " ", "0.2"}], ",", " ", "0.5", ",", " ", "1.0", ",",
    " ", "2.0", ",", " ", "3.0"}]], "Text",
  FontSize->14,ExpressionUUID->"b26a2f83-b5bc-4adb-b923-4e3fa35fdbba"],
 ".  ",
 "Entropy goes from ~0.6 nats (peaky) to ~3 nats (near-uniform); the ",
 "argmax stays the same, but how often we'd sample it changes ",
 "completely."
}], "Text",ExpressionUUID->"d4730865-face-4cf4-96f0-cc81e2992fe6"],

Cell["6.1.1  Interactive: the temperature dial", "Subsection",ExpressionUUID->"7fb18b05-3913-460b-9ee4-87428a8d2e80"],

Cell["\<\
Drag the slider to retemperature the same distribution and watch the entropy \
update live.  This cell only renders the interactive control when the \
notebook is evaluated in Wolfram Desktop; in the PDF/static view above we \
already showed five fixed snapshots.\
\>", "Text",ExpressionUUID->"250285ce-81ca-4ae1-b25f-93c392595252"],

Cell["\<\
Manipulate[
  BarChart[softmaxT[demoLogits, T],
    Frame -> True, FrameLabel -> {\"token id\", \"probability\"},
    PlotLabel -> Row[{\"T = \", NumberForm[T, 3], \"   entropy = \",
      NumberForm[entropyOf[softmaxT[demoLogits, T]], 3]}],
    PlotRange -> {Automatic, {0, 1}},
    ChartStyle -> ColorData[97][1], ImageSize -> 700],
  {{T, 1.0, \"temperature\"}, 0.05, 3.0, 0.05, Appearance -> \"Labeled\"},
  ControlPlacement -> Top]\
\>", "Input",ExpressionUUID->"a6605a0c-f83c-4efa-83f6-a567cd692888"],

Cell[BoxData[
 GraphicsBox[
  TagBox[RasterBox[CompressedData["1:"], {{0, 463.68}, {720., 0}}, {0, 255},
