Cell[TextData[StyleBox["Figure 3.4.  The mask, the masked-scores tensor, and \
the softmax weights.  The upper triangle is exactly zero after softmax; the \
lower triangle + diagonal carries the actual attention weights.",
 FontSize->11,
 FontSlant->Italic]], "Text",ExpressionUUID->"231391e6-5393-48b5-a39a-\
1cf210849306"],

Cell["3.3  Single-head attention as a NetGraph", "Section",ExpressionUUID->"f058635f-b426-41e0-a320-fbb3b9083ea1"],

Cell[TextData[{
 "Six nodes: three ",
 StyleBox["LinearLayer",
  FontFamily->"Courier"],
 " projections for Q, K, V; a ",
 StyleBox["FunctionLayer",
  FontFamily->"Courier"],
 " that computes ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"Q", "\[CenterDot]", 
    SuperscriptBox["K", "\[Transpose]"]}], 
   SqrtBox[
    SubscriptBox["d", "head"]]]], "Text",
  FontSize->14,ExpressionUUID->"8e70f693-71e0-4814-86b7-069b199037b7"],
 " and adds the causal mask; a ",
 StyleBox["SoftmaxLayer",
  FontFamily->"Courier"],
 "; a final ",
 StyleBox["FunctionLayer",
  FontFamily->"Courier"],
 " for the value gather.  Six lines."
}], "Text",ExpressionUUID->"d28c8f73-ac8e-4b13-9656-f022bede3e29"],

Cell["\<\
head = LLMAtoZ`Attention`singleHeadCausalAttention[64, 32, 16];
head\
\>", "Input",ExpressionUUID->"c65eef6a-d6b7-4cfa-9411-72f2b0934417"],

Cell[BoxData[
 GraphicsBox[
  TagBox[RasterBox[CompressedData["1:"], {{0, 100.8}, {720., 0}}, {0, 255},
